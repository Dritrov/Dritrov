  "definitions": [
    {
      "title": "Prime Power (PRP):",
      "text": "Prime power is the maximum power which a generating set is capable of delivering continuously whilst supplying a variable electrical load when operated for an unlimited number of hours per year under the agreed operating conditions with the maintenance intervals and procedures being carried out as prescribed by the manufacturer. The permissible average power output (Ppp) over 24 h of operation shall not exceed 70 % of the PRP."
    },
    {
      "title": "Emergency Standby Power (ESP):",
      "text": "Emergency standby power is the maximum power available during a variable electrical power sequence, under the stated operating conditions, for which a generating set is capable of delivering in the event of a utility power outage or under test conditions for up to 200 h of operation per year with the maintenance intervals and procedures being carried out as prescribed by the manufacturer. The permissible average power output over 24 h of operation shall not exceed 70 % of the ESP."
    }
  ],
  "note": "All data based on operation to BS 5514 and DIN 6271 standard reference conditions.",
